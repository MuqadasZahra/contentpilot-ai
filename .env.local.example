# Copy this file to .env.local and fill in your real keys

# Supabase (https://supabase.com -> create a free project -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# AI provider - use OpenAI or Anthropic, only fill in the one you use
OPENAI_API_KEY=your-openai-key
# ANTHROPIC_API_KEY=your-anthropic-key
